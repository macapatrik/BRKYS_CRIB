# Postgres připojení (Supabase pooler, transaction mode)
DATABASE_URL=

# Resend (emailové notifikace) — https://resend.com/api-keys
RESEND_API_KEY=
# Odesílatel; dokud nemáš ověřenou doménu, použij onboarding@resend.dev
RESEND_FROM="BRKYS CRIB <onboarding@resend.dev>"
# Email barbera, kam chodí notifikace o rezervacích a zrušeních
BARBER_EMAIL=

# Heslo pro přístup do /admin (povinné, jinak je správa nedostupná)
ADMIN_PASSWORD=

# Veřejná URL webu — používá se v odkazech v emailech
APP_URL=http://localhost:3000
